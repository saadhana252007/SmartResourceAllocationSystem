<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8EDF2">

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnCreateReservation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp"
                android:text="SELECTED RESOURCE"
                android:textColor="#0E2A45"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginTop="20dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="10dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="match_parent"
                        android:background="#1B3A57" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/imgResource"
                            android:layout_width="100dp"
                            android:layout_height="90dp"
                            android:scaleType="centerInside" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="14dp">

                            <TextView
                                android:id="@+id/tvResourceName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#0E2A45"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvResourceCategory"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#173B5E"
                                android:textSize="13.5sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />

                            <TextView
                                android:id="@+id/tvResourceLocation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#0E2A45"
                                android:textSize="13.5sp"
                                android:layout_marginTop="6dp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp"
                android:text="RESERVATION DETAILS"
                android:textColor="#0E2A45"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="10dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="match_parent"
                        android:background="#1B3A57" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Date"
                            android:textColor="#102336"
                            android:textStyle="bold"
                            android:textSize="17sp"
                            android:layout_marginBottom="8dp"
                            android:fontFamily="sans-serif-medium"/>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="18dp"
                            android:hint="Select Date"
                            app:boxBackgroundMode="outline"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp"
                            app:boxStrokeColor="#102336"
                            app:hintTextColor="#BDBDBD">

                            <TextView
                                android:id="@+id/tvSelectedDate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="16dp"
                                android:text="Select Date"
                                android:textColor="#102336"
                                android:textSize="16sp"
                                android:gravity="center_vertical"
                                android:background="#E8EDF2"/>

                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Start Time"
                            android:textColor="#102336"
                            android:textStyle="bold"
                            android:textSize="17sp"
                            android:layout_marginBottom="8dp"
                            android:fontFamily="sans-serif-medium"/>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="18dp"
                            android:hint="Select Time"
                            app:boxBackgroundMode="outline"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp"
                            app:boxStrokeColor="#102336"
                            app:hintTextColor="#BDBDBD">

                            <TextView
                                android:id="@+id/tvSelectedTime"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="16dp"
                                android:text="Select Time"
                                android:textColor="#102336"
                                android:textSize="16sp"
                                android:gravity="center_vertical"
                                android:background="#E8EDF2"/>

                        </com.google.android.material.textfield.TextInputLayout>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardBookingStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="18dp"
                            android:visibility="gone"
                            app:cardBackgroundColor="#E3EEFB"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="14dp">

                                <TextView
                                    android:id="@+id/tvBookingStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textStyle="bold"
                                    android:textSize="16sp"
                                    android:textColor="#0E2A45" />

                                <TextView
                                    android:id="@+id/tvBookingMessage"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="#0E2A45"
                                    android:textSize="13.5sp"
                                    android:layout_marginTop="4dp" />

                                <TextView
                                    android:id="@+id/tvRequestsReceived"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="#0E2A45"
                                    android:textSize="13.5sp"
                                    android:layout_marginTop="4dp" />

                                <TextView
                                    android:id="@+id/tvAvailableUnits"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="#0E2A45"
                                    android:textSize="13.5sp"
                                    android:layout_marginTop="4dp" />

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Duration"
                            android:textColor="#102336"
                            android:textStyle="bold"
                            android:textSize="17sp"
                            android:layout_marginBottom="8dp"
                            android:fontFamily="sans-serif-medium"/>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="18dp"
                            app:boxBackgroundMode="outline"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp"
                            app:boxStrokeColor="#102336"
                            app:hintTextColor="#BDBDBD">

                            <Spinner
                                android:id="@+id/spinnerDuration"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:background="#E8EDF2"/>

                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Allocation Preference"
                            android:textColor="#102336"
                            android:textStyle="bold"
                            android:textSize="17sp"
                            android:layout_marginBottom="8dp"
                            android:fontFamily="sans-serif-medium"/>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="18dp"
                            app:boxBackgroundMode="outline"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp"
                            app:boxStrokeColor="#102336"
                            app:hintTextColor="#BDBDBD">

                            <Spinner
                                android:id="@+id/spinnerAllocationPreference"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:background="#E8EDF2"/>

                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Purpose Description"
                            android:textColor="#102336"
                            android:textStyle="bold"
                            android:textSize="17sp"
                            android:layout_marginBottom="8dp"
                            android:fontFamily="sans-serif-medium"/>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="18dp"
                            android:hint="Describe why you need this resource..."
                            app:boxBackgroundMode="outline"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp"
                            app:boxStrokeColor="#102336"
                            app:hintTextColor="#BDBDBD">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPurposeDescription"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="top|start"
                                android:inputType="textMultiLine"
                                android:minLines="4"
                                android:maxLines="6"
                                android:maxLength="500"
                                android:textColor="#102336"
                                android:textSize="16sp"
                                android:background="#E8EDF2"/>

                        </com.google.android.material.textfield.TextInputLayout>

                        <LinearLayout
                            android:id="@+id/layoutParticipantCount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Participant Count"
                                android:textColor="#102336"
                                android:textStyle="bold"
                                android:textSize="17sp"
                                android:layout_marginBottom="8dp"
                                android:fontFamily="sans-serif-medium"/>

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="18dp"
                                android:hint="Enter participant count"
                                app:boxBackgroundMode="outline"
                                app:boxCornerRadiusTopStart="14dp"
                                app:boxCornerRadiusTopEnd="14dp"
                                app:boxCornerRadiusBottomStart="14dp"
                                app:boxCornerRadiusBottomEnd="14dp"
                                app:boxStrokeColor="#102336"
                                app:hintTextColor="#BDBDBD">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etParticipantCount"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:textColor="#102336"
                                    android:textSize="16sp"
                                    android:background="#E8EDF2"/>

                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layoutQuantityRequired"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Quantity Required"
                                android:textColor="#102336"
                                android:textStyle="bold"
                                android:textSize="17sp"
                                android:layout_marginBottom="8dp"
                                android:fontFamily="sans-serif-medium"/>

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="18dp"
                                android:hint="Enter required quantity"
                                app:boxBackgroundMode="outline"
                                app:boxCornerRadiusTopStart="14dp"
                                app:boxCornerRadiusTopEnd="14dp"
                                app:boxCornerRadiusBottomStart="14dp"
                                app:boxCornerRadiusBottomEnd="14dp"
                                app:boxStrokeColor="#102336"
                                app:hintTextColor="#BDBDBD">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etQuantityRequired"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:textColor="#102336"
                                    android:textSize="16sp"
                                    android:background="#E8EDF2"/>

                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnCreateReservation"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/rounded_bagde"
        android:backgroundTint="#173B5E"
        android:text="CREATE RESERVATION"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>