<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg">

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="30dp"
        app:layout_constraintBottom_toTopOf="@id/btnCreateReservation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:layout_marginTop="80dp"
                android:backgroundTint="#E3EFF7"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/imgResource"
                        android:layout_width="120dp"
                        android:layout_height="100dp"
                        android:scaleType="centerCrop"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp">

                        <TextView
                            android:id="@+id/tvResourceName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#1B3A57"
                            android:textSize="20sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvResourceCategory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#1B3A57"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginTop="5dp"/>

                        <TextView
                            android:id="@+id/tvResourceLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#1B3A57"
                            android:textSize="15sp"
                            android:layout_marginTop="8dp"/>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:backgroundTint="#E3EFF7"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reservation Details"
                        android:textColor="#1B3A57"
                        android:textSize="20sp"
                        android:textStyle="bold"/>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Date"
                        android:textColor="#1B3A57"
                        android:textStyle="bold"
                        android:layout_marginTop="15dp"/>

                    <TextView
                        android:id="@+id/tvSelectedDate"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/text_view_box"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:text="Select Date"
                        android:textColor="@color/white"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Start Time"
                        android:textColor="#1B3A57"
                        android:textStyle="bold"
                        android:layout_marginTop="15dp"/>

                    <TextView
                        android:id="@+id/tvSelectedTime"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/text_view_box"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:text="Select Time"
                        android:textColor="@color/white"/>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardBookingStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:visibility="gone"
                        android:backgroundTint="#E3EFF7"
                        app:cardCornerRadius="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:id="@+id/tvBookingStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textStyle="bold"
                                android:textSize="18sp"
                                android:textColor="#1B3A57"/>

                            <TextView
                                android:id="@+id/tvBookingMessage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#1B3A57"
                                android:layout_marginTop="5dp"/>

                            <TextView
                                android:id="@+id/tvRequestsReceived"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#1B3A57"
                                android:layout_marginTop="5dp"/>

                            <TextView
                                android:id="@+id/tvAvailableUnits"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#1B3A57"
                                android:layout_marginTop="5dp"/>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>


                    <Spinner
                        android:id="@+id/spinnerDuration"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="15dp"
                        android:background="@drawable/spinner_bg"/>

                    <Spinner
                        android:id="@+id/spinnerPurpose"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="15dp"
                        android:background="@drawable/spinner_bg"/>

                    <Spinner
                        android:id="@+id/spinnerAllocationPreference"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="15dp"
                        android:background="@drawable/spinner_bg"/>

                    <LinearLayout
                        android:id="@+id/layoutParticipantCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="15dp">

                        <EditText
                            android:id="@+id/etParticipantCount"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@drawable/text_view_box"
                            android:hint="Participant Count"
                            android:inputType="number"
                            android:paddingStart="16dp"
                            android:textColor="@color/white"
                            android:textColorHint="@color/white"/>

                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/layoutQuantityRequired"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="15dp">

                        <EditText
                            android:id="@+id/etQuantityRequired"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@drawable/text_view_box"
                            android:hint="Quantity Required"
                            android:inputType="number"
                            android:paddingStart="16dp"
                            android:textColor="@color/white"
                            android:textColorHint="@color/white"/>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

    <Button
        android:id="@+id/btnCreateReservation"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="25dp"
        android:text="CREATE RESERVATION"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="@drawable/button_box"
        app:backgroundTint="@null"
        android:fontFamily="@font/eagle_lake"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>