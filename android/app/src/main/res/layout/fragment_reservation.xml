<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#E8EDF2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="26dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:gravity="center_horizontal"
        android:layout_marginTop="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MY RESERVATIONS"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#0E2A45"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Track the status of every booking"
            android:textColor="#8A94A6"
            android:textSize="14sp"/>

    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All"
                android:textColor="@color/tab_text_color"
                android:textStyle="bold"
                android:textSize="17sp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="11dp"
                android:layout_marginEnd="10dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/tab_selector"/>

            <TextView
                android:id="@+id/tabPending"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending"
                android:textColor="@color/tab_text_color"
                android:textStyle="bold"
                android:textSize="17sp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="11dp"
                android:layout_marginEnd="10dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/tab_selector"/>

            <TextView
                android:id="@+id/tabApproved"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Approved"
                android:textColor="@color/tab_text_color"
                android:textStyle="bold"
                android:textSize="17sp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="11dp"
                android:layout_marginEnd="10dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/tab_selector"/>

            <TextView
                android:id="@+id/tabWaitlisted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Waitlisted"
                android:textColor="@color/tab_text_color"
                android:textStyle="bold"
                android:textSize="17sp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="11dp"
                android:layout_marginEnd="10dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/tab_selector"/>

            <TextView
                android:id="@+id/tabCancelled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancelled"
                android:textColor="@color/tab_text_color"
                android:textStyle="bold"
                android:textSize="17sp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="11dp"
                android:layout_marginEnd="10dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/tab_selector"/>

            <TextView
                android:id="@+id/tabRejected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rejected"
                android:textColor="@color/tab_text_color"
                android:textStyle="bold"
                android:textSize="17sp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="11dp"
                android:layout_marginEnd="20dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/tab_selector"/>

        </LinearLayout>

    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvReservations"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:scrollbars="none"/>

</LinearLayout>