<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#E8EDF2">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reservation Management"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#0E2A45"
            android:fontFamily="sans-serif-medium"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Review and manage all bookings"
            android:textColor="#8A94A6"
            android:textSize="13.5sp"
            android:layout_gravity="center"/>

    </LinearLayout>

    <!-- ============ Search ============ -->

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="26dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingHorizontal="18dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/search_icon"
                android:alpha="0.55"/>

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Search resources..."
                android:textColor="#0E2A45"
                android:textColorHint="#A6AEBB"
                android:textSize="14.5sp"
                android:paddingStart="12dp"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>


    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All"
                android:textColor="@color/tab_text_color"
                android:textStyle="bold"
                android:textSize="17sp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="11dp"
                android:layout_marginEnd="10dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/tab_selector"/>

            <TextView
                android:id="@+id/tabPending"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending"
                android:textColor="@color/tab_text_color"
                android:textStyle="bold"
                android:textSize="17sp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="11dp"
                android:layout_marginEnd="10dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/tab_selector"/>

            <TextView
                android:id="@+id/tabAllocated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Approved"
                android:textColor="@color/tab_text_color"
                android:textStyle="bold"
                android:textSize="17sp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="11dp"
                android:layout_marginEnd="10dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/tab_selector"/>

            <TextView
                android:id="@+id/tabWaitlisted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Waitlisted"
                android:textColor="@color/tab_text_color"
                android:textStyle="bold"
                android:textSize="17sp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="11dp"
                android:layout_marginEnd="10dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/tab_selector"/>

            <TextView
                android:id="@+id/tabCancelled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancelled"
                android:textColor="@color/tab_text_color"
                android:textStyle="bold"
                android:textSize="17sp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="11dp"
                android:layout_marginEnd="20dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/tab_selector"/>

        </LinearLayout>

    </HorizontalScrollView>


    <TextView
        android:id="@+id/tvTotalReservations"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginStart="20dp"
        android:text="Total Reservations : 0"
        android:textStyle="bold"
        android:textColor="#435A70"
        android:textSize="13sp"
        android:letterSpacing="0.02"/>


    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        app:shimmer_auto_start="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <include layout="@layout/item_reservation_shimmer"/>
            <include layout="@layout/item_reservation_shimmer"/>
            <include layout="@layout/item_reservation_shimmer"/>
            <include layout="@layout/item_reservation_shimmer"/>

        </LinearLayout>

    </com.facebook.shimmer.ShimmerFrameLayout>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvReservations"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:paddingHorizontal="20dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:scrollbars="none"/>

</LinearLayout>